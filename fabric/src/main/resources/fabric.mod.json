{
  "schemaVersion": 1,
  "id": "turtlelib",
  "version": "${version}",
  "name": "TurtleLib",
  "icon": "assets/turtlelib/icon.png",
  "description": "Shared helper library for Fabric/NeoForge mods.",
  "authors": [
    "hrobasti"
  ],
  "license": "Apache-2.0",
  "contact": {
    "homepage": "https://github.com/hrobasti/turtle-lib-mod"
  },
  "environment": "*",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_language_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.source": "https://github.com/hrobasti/turtle-lib-mod",
        "modmenu.github_sponsors": "https://github.com/sponsors/hrobasti",
        "modmenu.kofi": "https://ko-fi.com/hrobasti"
      },
      "badges": ["library"],
      "update_checker": false
    }
  }
}
