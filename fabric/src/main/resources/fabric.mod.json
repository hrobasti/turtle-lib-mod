{
  "schemaVersion": 1,
  "id": "turtlelib",
  "version": "${version}",
  "name": "TurtleLib",
  "description": "Helper library for Fabric and NeoForge mods by kroet.net. Adds no gameplay on its own; install it when a mod requires it.",
  "authors": [
    {
      "name": "kroet.net",
      "contact": {
        "homepage": "https://kroet.net"
      }
    }
  ],
  "license": "MIT",
  "icon": "assets/turtlelib/icon.png",
  "contact": {
    "homepage": "https://kroet.net",
    "sources": "https://github.com/hrobasti/turtle-lib-mod",
    "issues": "https://github.com/hrobasti/turtle-lib-mod/issues"
  },
  "environment": "*",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_language_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_sponsors": "https://github.com/sponsors/hrobasti",
        "modmenu.kofi": "https://ko-fi.com/kroet"
      },
      "badges": ["library"]
    }
  }
}
